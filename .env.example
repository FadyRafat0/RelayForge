HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://relayforge:relayforge_local@127.0.0.1:5432/relayforge
REDIS_URL=redis://127.0.0.1:6379
ALLOW_LOOPBACK_ENDPOINTS=false
WORKER_CONCURRENCY=4

# Receiver only: set RECEIVER_SIGNING_SECRET from POST /api/endpoints in its terminal.

# Receiver namespace: keep stable across restarts and secret rotation.
RECEIVER_ID=local-demo

# compose.demo.yaml uses its own database and Redis volumes, without this file.
# Optional shell overrides: DEMO_PORT=3100, DEMO_WORKER_CONCURRENCY=4, DEMO_LOG_LEVEL=info
